{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:<ACCOUNT_ID>:log-group:/aws/lambda/<FUNCTION_NAME>*"
    },
    {
      "Sid": "CeilingReadAndTagAndAct",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots",
        "ec2:DescribeImages",
        "ec2:DescribeNatGateways",
        "ec2:DescribeAddresses",
        "rds:DescribeDBInstances",
        "rds:ListTagsForResource",
        "lambda:ListFunctions",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTargetGroups",
        "s3:ListAllMyBuckets",
        "s3:ListBucket",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "rds:AddTagsToResource",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:DeregisterImage",
        "rds:StopDBInstance",
        "rds:CreateDBSnapshot"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CeilingNotifyAndSchedule",
      "Effect": "Allow",
      "Action": [
        "sns:Publish",
        "scheduler:CreateSchedule"
      ],
      "Resource": [
        "<SNS_TOPIC_ARN>",
        "arn:aws:scheduler:*:<ACCOUNT_ID>:schedule/<SCHEDULER_GROUP>/<FUNCTION_NAME>-*"
      ]
    },
    {
      "Sid": "CeilingPassSchedulerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "<SCHEDULER_ROLE_ARN>",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyActionsOnProtectedResources",
      "Effect": "Deny",
      "Action": [
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:DeregisterImage",
        "rds:StopDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "aws:ResourceTag/<PROTECT_TAG_KEY>": "<PROTECT_TAG_VALUE>"
        }
      }
    },
    {
      "Sid": "DenyActionsOnScheduledResources",
      "Effect": "Deny",
      "Action": [
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:DeregisterImage",
        "rds:StopDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/<EXTRA_PROTECT_TAG_KEY>": "false"
        }
      }
    },
    {
      "Sid": "NeverDeleteOrStartDatabases",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance",
        "rds:DeleteDBCluster",
        "rds:StartDBInstance"
      ],
      "Resource": "*"
    }
  ]
}
